# Copy to `.env` in the project root next to `package.json` (gitignored).
# The Electron main process also checks `process.cwd()` and (when packaged) beside the .app / exe.
# Restart the desktop app after changes. Env vars override keys saved under Audio → Lyrics translation.

# Optional: DeepSeek / OpenAI-compatible lyrics + translation (falls back without these).
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_COMPATIBLE_LYRICS_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_LYRICS_MODEL=deepseek-chat

# Optional (recommended for “Google AI” song meaning): get a key from https://aistudio.google.com/apikey
# When set, “What this song is about” uses Gemini first; lyric LLM remains on DeepSeek/OpenAI above if configured.
GEMINI_API_KEY=
# Or: GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
